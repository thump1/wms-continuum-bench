// Nextflow configuration — SWMS POC
// Eduardo López — PhD thesis SWMS exploration

manifest {
    name            = 'swms-poc-nextflow'
    description     = 'Nextflow POC for the doctoral thesis on SWMS in the IoT-Edge-Cloud continuum'
    author          = 'Eduardo López'
    version         = '0.1.0'
    nextflowVersion = '>=24.04.0'
}

// ---------- Default ----------

process {
    executor      = 'local'
    cpus          = 1
    memory        = '2 GB'
    errorStrategy = 'retry'
    maxRetries    = 1
}

// ---------- Profiles ----------

profiles {

    standard {
        process {
            executor = 'local'
            cpus     = 1
            memory   = '12 GB'
        }
        docker.enabled = false
    }

    docker {
        process {
            executor = 'local'
            cpus     = 1
            memory   = '12 GB'
        }
        docker {
            enabled    = true
            runOptions = '-u $(id -u):$(id -g)'
        }
    }

    server {
        process {
            executor = 'local'
            cpus     = 4
            memory   = '20 GB'
        }
        docker {
            enabled    = true
            runOptions = '-u $(id -u):$(id -g)'
        }
    }

    singularity {
        process {
            executor = 'local'
            cpus     = 4
            memory   = '20 GB'
        }
        singularity {
            enabled    = true
            autoMounts = true
        }
    }

    k8s {
        process {
            executor = 'k8s'
            cpus     = 1
            memory   = '512 MB'
        }
        k8s {
            namespace        = 'scientific'
            context          = 'k3d-continuum'
            storageClaimName = 'nextflow-pvc'
            storageMountPath = '/private/tmp/k3d-nf-work'
            serviceAccount   = 'nextflow'
        }
    }
}

// ---------- Reports (always on — important for thesis benchmarks) ----------
//
// Reports go into reports/ and overwrite on each run. If you want a
// per-run history, copy or rename the report files after each invocation,
// or pass -name <label> to use Nextflow's runName instead.

report {
    enabled   = true
    file      = "reports/report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "reports/timeline.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "reports/trace.txt"
    overwrite = true
    fields    = 'task_id,hash,name,status,exit,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

dag {
    enabled   = true
    file      = "reports/dag.html"
    overwrite = true
}
